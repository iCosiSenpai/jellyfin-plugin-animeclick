<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>AnimeClick.Plugin</AssemblyName>
    <RootNamespace>AnimeClick.Plugin</RootNamespace>
    <Version>1.6.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageId>AnimeClick.Plugin</PackageId>
    <Authors>Alessio Cosi</Authors>
    <Copyright>Copyright (C) 2026 Alessio Cosi (iCosiSenpai)</Copyright>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iCosiSenpai/jellyfin-plugin-animeclick</PackageProjectUrl>
    <Description>AnimeClick-first Italian anime metadata provider for Jellyfin with native episode synopses and optional cloud translation fallback.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin SDK packages — exclude assets to avoid copying server DLLs into plugin output -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AnimeClick.Plugin.Tests\**\*.cs" />
    <None Remove="AnimeClick.Plugin.Tests\**\*" />
    <!-- Development tool, not part of the plugin: see tools/AnimeClick.Harness. -->
    <Compile Remove="tools\**\*.cs" />
    <None Remove="tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Web\assets\*.*" />
    <EmbeddedResource Include="Web\assets\*.*" />
    <!-- Official provider logos, shown next to each source on the configuration page. -->
    <EmbeddedResource Include="assets\providers\tmdb.svg" LogicalName="AnimeClick.Plugin.ProviderLogos.tmdb.svg" />
    <EmbeddedResource Include="assets\providers\fanart.png" LogicalName="AnimeClick.Plugin.ProviderLogos.fanart.png" />
    <EmbeddedResource Include="assets\providers\thetvdb-dark.png" LogicalName="AnimeClick.Plugin.ProviderLogos.thetvdb-dark.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AnimeClick.Plugin.Tests" />
    <!-- The audit harness in tools/ replays the production pipeline, which needs the same
         internal entry points as the tests (FinalizeEpisodeList and friends). -->
    <InternalsVisibleTo Include="AnimeClick.Harness" />
  </ItemGroup>
</Project>
