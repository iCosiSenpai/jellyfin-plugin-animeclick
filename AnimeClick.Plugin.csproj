<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <AssemblyName>AnimeClick.Plugin</AssemblyName>
    <RootNamespace>AnimeClick.Plugin</RootNamespace>
    <Version>0.4.4.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <PackageId>AnimeClick.Plugin</PackageId>
    <Authors>Alessio Cosi</Authors>
    <Description>AnimeClick-first Italian anime metadata provider for Jellyfin with native episode synopses and optional cloud translation fallback.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jellyfin SDK packages — exclude assets to avoid copying server DLLs into plugin output -->
    <PackageReference Include="Jellyfin.Controller" Version="10.11.8">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="10.11.8">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="HtmlAgilityPack" Version="1.11.71" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="AnimeClick.Plugin.Tests\**\*.cs" />
    <None Remove="AnimeClick.Plugin.Tests\**\*" />
    <!-- Development tool, not part of the plugin: see tools/AnimeClick.Harness. -->
    <Compile Remove="tools\**\*.cs" />
    <None Remove="tools\**\*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
    <None Remove="Web\assets\*.*" />
    <EmbeddedResource Include="Web\assets\*.*" />
    <None Remove="assets\banner.png;assets\logo.png" />
    <EmbeddedResource Include="assets\banner.png;assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AnimeClick.Plugin.Tests" />
    <!-- The audit harness in tools/ replays the production pipeline, which needs the same
         internal entry points as the tests (FinalizeEpisodeList and friends). -->
    <InternalsVisibleTo Include="AnimeClick.Harness" />
  </ItemGroup>
</Project>
